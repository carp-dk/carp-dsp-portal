# Copy to .env beside docker-compose.yml and fill in. Keep .env off git.

# The image tag to run: the one in the package name.
TAG=

# The CARP database, read-only role.
CARP_DSP_SQL_URL=jdbc:postgresql://HOST:5432/DATABASE
CARP_DSP_SQL_USER=
CARP_DSP_SQL_PASSWORD=

# Where the portal listens on this machine. Keep 127.0.0.1 behind a reverse proxy.
DSP_BIND=127.0.0.1
DSP_PUBLISH_PORT=8080

# Memory for the Java steps (decoding a whole study). Give the container 6 GB or more.
JAVA_TOOL_OPTIONS=-Xmx4g
